{
  "name": "captchaai-javascript",
  "version": "1.0.1",
  "description": "Official CaptchaAI Node.js and TypeScript SDK — solve reCAPTCHA, Turnstile, GeeTest, and image CAPTCHAs.",
  "author": "Dev@Captchaai <dev@captchaai.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptchaAI/captchaai-javascript.git"
  },
  "homepage": "https://captchaai.com/",
  "bugs": {
    "url": "https://github.com/CaptchaAI/captchaai-javascript/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "test": "vitest run --config tests/vitest.config.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "captcha",
    "captchaai",
    "captcha-solver",
    "captcha-solving",
    "captcha-bypass",
    "captcha-recognition",
    "solver",
    "bypass",
    "recaptcha",
    "recaptcha-solver",
    "recaptcha-bypass",
    "recaptcha-v2",
    "recaptcha-v2-solver",
    "recaptcha-v3",
    "recaptcha-v3-solver",
    "recaptcha-enterprise",
    "turnstile",
    "cloudflare-turnstile",
    "turnstile-solver",
    "cloudflare-challenge",
    "geetest",
    "geetest-v3",
    "geetest-solver",
    "image-captcha",
    "text-captcha",
    "captchafox",
    "friendly-captcha",
    "lemin",
    "web-scraping",
    "scraping",
    "browser-automation",
    "automation",
    "nodejs",
    "javascript",
    "typescript",
    "sdk",
    "api-client"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
